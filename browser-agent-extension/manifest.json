{
  "manifest_version": 3,
  "name": "BLEA Browser Companion (Preview)",
  "version": "0.2.0",
  "description": "User-directed, visible browser actions for BLEA Agent.",
  "permissions": ["activeTab", "scripting", "tabs", "clipboardRead", "clipboardWrite", "sidePanel", "storage"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "content_scripts": [{
    "matches": ["https://blea.ai/*", "http://localhost/*", "http://127.0.0.1/*"],
    "js": ["bridge-content.js"],
    "run_at": "document_start"
  }],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "popup.html" },
  "action": { "default_title": "Open BLEA Browser Companion" }
}
